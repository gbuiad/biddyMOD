{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "biddymod",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      },
      "modqueue": {
      "entry": "modqueue.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "biddymod",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/example-form"
      },
      {
      "label": "biddyMOD Queue",
      "description": "View flagged content",
      "location": "subreddit",
      "forUserType": "moderator",
      "endpoint": "/internal/menu/open-modqueue"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "settings": {
    "global": {
      "perspective-api-key": {
        "type": "string",
        "label": "Perspective API key",
        "helpText": "Google Perspective API key used to analyze toxicity.",
        "isSecret": true
      },
      "gemini-api-key": {
        "type": "string",
        "label": "Gemini API key",
        "helpText": "Google Gemini API key used to summarize moderation decisions.",
        "isSecret": true
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onCommentCreate": "/internal/triggers/on-comment-create",
    "onPostReport": "/internal/triggers/on-post-report"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
